# Copy to .env for local development. NEVER commit .env. On hosting platforms use the platform's secrets instead.

# --- Application ---
APP_ENV=development                 # development | production
DATABASE_URL=sqlite:///careerforge.db   # only sqlite:/// is supported in this version (use an absolute path in production, e.g. sqlite:////data/careerforge.db)
LOG_LEVEL=INFO
LOG_FILE=                           # optional, e.g. careerforge.log (rotated, secrets/emails redacted)
MAX_UPLOAD_MB=5
AUTH_SESSION_HOURS=8                # how long a sign-in lasts

# --- AI provider (optional server-wide defaults; users can enter their own key in the app) ---
OPENAI_API_KEY=                     # optional fallback key; keep it secret
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
MAX_LLM_CHARS=20000                 # max characters of one document sent per AI request
AI_DAILY_LIMIT=100                  # AI requests per user per UTC day; 0 = unlimited. Monitor spend in your provider's usage dashboard.

# --- Embeddings / RAG ---
EMBEDDING_PROVIDER=openai           # openai | local
EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
